# Frontend (Vite) — set in Vercel for split deploy
# Empty = same-origin /api (Cloudflare Workers + assets)
VITE_API_BASE_URL=

# Cloudflare Worker secrets (wrangler secret put …)
# JWT_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# GEMINI_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=hello@codedmotion.studio
# RESEND_ADMIN_EMAIL=admin@codedmotion.studio
# RESEND_SUPPORT_EMAIL=support@codedmotion.studio
# RESEND_DMCA_EMAIL=dmca@codedmotion.studio
# RESEND_NOREPLY_EMAIL=noreply@codedmotion.studio
# INTERNAL_WEBHOOK_SECRET=
